# PDF / Chromium support on Elastic Beanstalk
option_settings:
  aws:elasticbeanstalk:application:environment:
    USE_SPARTICUZ_CHROMIUM: "true"

# Best-effort OS libs (ignore failures on AL2023 package name differences)
commands:
  01_chromium_libs:
    command: |
      yum install -y atk cups-libs libXcomposite libXcursor libXdamage libXext libXi libXrandr libXScrnSaver libXtst pango gtk3 alsa-lib nss nspr || true
    ignoreErrors: true
